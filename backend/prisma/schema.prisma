generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(auto()) @map("_id") @test.ObjectId
  email          String   @unique
  username       String
  password       String
  verified       Boolean  @default(false)
  otp            String?
  passwordlessToken String?
  github         GithubData?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model GithubData {
  id        String   @id @default(auto()) @map("_id") @test.ObjectId
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  githubId  String
  login     String
  name      String?
  avatarUrl String?
  bio       String?
  repos     GithubRepo[]
  fetchedAt DateTime @default(now())
}

model GithubRepo {
  id          String   @id @default(auto()) @map("_id") @test.ObjectId
  githubData  GithubData @relation(fields: [githubDataId], references: [id])
  githubDataId String
  repoId      String
  name        String
  htmlUrl     String
  description String?
  language    String?
  stargazersCount Int?
  forksCount  Int?
  updatedAt   DateTime?
}